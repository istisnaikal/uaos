{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "uaos.credential/1",
  "description": "One identity entry: a credential issued or revoked, an epoch bumped, or recovery after a restore.",
  "type": "object",
  "properties": {
    "op": {
      "description": "What happened.",
      "$ref": "#/$defs/CredentialOp"
    },
    "schema": {
      "description": "Schema tag, always `uaos.credential/1`.",
      "$ref": "#/$defs/CredentialSchema"
    }
  },
  "additionalProperties": false,
  "required": [
    "schema",
    "op"
  ],
  "$defs": {
    "ActionName": {
      "type": "string",
      "pattern": "^[a-z0-9_.:]{1,64}$"
    },
    "CredentialDigest": {
      "type": "string",
      "pattern": "^hmac-sha256:[0-9a-f]{64}$"
    },
    "CredentialId": {
      "type": "string",
      "pattern": "^cred_[0-9a-f]{12}7[0-9a-f]{3}[89ab][0-9a-f]{15}$"
    },
    "CredentialKind": {
      "description": "What a credential is in the hierarchy.",
      "oneOf": [
        {
          "description": "Held by the human principal; issues sub credentials. No parent.",
          "type": "string",
          "const": "master"
        },
        {
          "description": "Normally one per pocket; what `uaos run` hands to an agent.",
          "type": "string",
          "const": "sub"
        },
        {
          "description": "Optional, e.g. per subagent.",
          "type": "string",
          "const": "child"
        }
      ]
    },
    "CredentialOp": {
      "description": "What an identity entry records.",
      "oneOf": [
        {
          "description": "A credential was issued.",
          "type": "object",
          "properties": {
            "kind": {
              "type": "string",
              "const": "issued"
            },
            "record": {
              "description": "The new credential.",
              "$ref": "#/$defs/CredentialRecord"
            }
          },
          "additionalProperties": false,
          "required": [
            "kind",
            "record"
          ]
        },
        {
          "description": "One credential was revoked.",
          "type": "object",
          "properties": {
            "credential": {
              "description": "The revoked credential.",
              "$ref": "#/$defs/CredentialId"
            },
            "kind": {
              "type": "string",
              "const": "revoked"
            },
            "revocation_seq": {
              "description": "The installation's revocation count after this revocation (restore guard).",
              "$ref": "#/$defs/RevocationSeq"
            }
          },
          "additionalProperties": false,
          "required": [
            "kind",
            "credential",
            "revocation_seq"
          ]
        },
        {
          "description": "A credential's epoch was bumped, revoking every descendant issued under the old one.",
          "type": "object",
          "properties": {
            "credential": {
              "description": "The credential whose epoch changed.",
              "$ref": "#/$defs/CredentialId"
            },
            "epoch": {
              "description": "The new epoch.",
              "$ref": "#/$defs/Epoch"
            },
            "kind": {
              "type": "string",
              "const": "epoch_bumped"
            },
            "revocation_seq": {
              "description": "The installation's revocation count after this bump (restore guard).",
              "$ref": "#/$defs/RevocationSeq"
            }
          },
          "additionalProperties": false,
          "required": [
            "kind",
            "credential",
            "epoch",
            "revocation_seq"
          ]
        },
        {
          "description": "Recovery after a restored data directory (ADR-0011 §7): this entry revokes every master\nthat is still live, atomically, and raises the journal's revocation count above the\nkeychain's.",
          "type": "object",
          "properties": {
            "kind": {
              "type": "string",
              "const": "restore_recovered"
            },
            "revocation_seq": {
              "description": "The installation's revocation count after recovery.",
              "$ref": "#/$defs/RevocationSeq"
            }
          },
          "additionalProperties": false,
          "required": [
            "kind",
            "revocation_seq"
          ]
        }
      ]
    },
    "CredentialRecord": {
      "description": "One issued credential.",
      "type": "object",
      "properties": {
        "digest": {
          "description": "Keyed digest of the secret; verification looks credentials up by it.",
          "$ref": "#/$defs/CredentialDigest"
        },
        "epoch": {
          "description": "This credential's epoch at issuance (initially 0).",
          "$ref": "#/$defs/Epoch"
        },
        "id": {
          "description": "Identifier (`cred_…`), shown in explanations and the journal; not a secret.",
          "$ref": "#/$defs/CredentialId"
        },
        "issued_at": {
          "description": "When it was issued.",
          "$ref": "#/$defs/WallTime"
        },
        "kind": {
          "description": "Position in the hierarchy.",
          "$ref": "#/$defs/CredentialKind"
        },
        "label": {
          "description": "Human-readable label.",
          "anyOf": [
            {
              "$ref": "#/$defs/Label"
            },
            {
              "type": "null"
            }
          ]
        },
        "parent": {
          "description": "The issuing credential; `None` exactly for a master.",
          "anyOf": [
            {
              "$ref": "#/$defs/CredentialId"
            },
            {
              "type": "null"
            }
          ]
        },
        "parent_epoch": {
          "description": "The parent's epoch at issuance; a different current parent epoch revokes this credential.",
          "$ref": "#/$defs/Epoch"
        },
        "scope": {
          "description": "Upper bound on what the credential may do.",
          "$ref": "#/$defs/Scope"
        }
      },
      "additionalProperties": false,
      "required": [
        "id",
        "kind",
        "digest",
        "scope",
        "issued_at",
        "parent_epoch",
        "epoch"
      ]
    },
    "CredentialSchema": {
      "description": "Schema tag of the credential contract.",
      "oneOf": [
        {
          "description": "Version 1.",
          "type": "string",
          "const": "uaos.credential/1"
        }
      ]
    },
    "Epoch": {
      "description": "Unsigned 64-bit integer as a canonical decimal string.",
      "type": "string",
      "pattern": "^(0|[1-9][0-9]{0,19})$"
    },
    "Label": {
      "type": "string",
      "pattern": "^[^\\u0000-\\u001f\\u007f-\\u009f]{1,64}$"
    },
    "PatternMatch": {
      "description": "How a pattern matches. Only these two, so containment between patterns stays decidable\n(ADR-0011 §4).",
      "oneOf": [
        {
          "description": "The resource name equals the value.",
          "type": "string",
          "const": "exact"
        },
        {
          "description": "The resource name starts with the value.",
          "type": "string",
          "const": "prefix"
        }
      ]
    },
    "PatternValue": {
      "type": "string",
      "pattern": "^[!-~]{1,64}$"
    },
    "PocketId": {
      "type": "string",
      "pattern": "^pkt_[0-9a-f]{12}7[0-9a-f]{3}[89ab][0-9a-f]{15}$"
    },
    "PoolId": {
      "type": "string",
      "pattern": "^pool_[0-9a-f]{12}7[0-9a-f]{3}[89ab][0-9a-f]{15}$"
    },
    "ResourceKind": {
      "description": "What kind of resource a pattern names.",
      "oneOf": [
        {
          "description": "A model, e.g. `claude-sonnet-5-5`.",
          "type": "string",
          "const": "model"
        },
        {
          "description": "A tool.",
          "type": "string",
          "const": "tool"
        },
        {
          "description": "A configuration key.",
          "type": "string",
          "const": "config_key"
        }
      ]
    },
    "ResourcePattern": {
      "description": "A resource pattern such as \"models whose name starts with `claude-`\".",
      "type": "object",
      "properties": {
        "kind": {
          "description": "Kind of resource.",
          "$ref": "#/$defs/ResourceKind"
        },
        "match": {
          "description": "How `value` matches.",
          "$ref": "#/$defs/PatternMatch"
        },
        "value": {
          "description": "The literal name or prefix.",
          "$ref": "#/$defs/PatternValue"
        }
      },
      "additionalProperties": false,
      "required": [
        "kind",
        "match",
        "value"
      ]
    },
    "RevocationSeq": {
      "description": "Unsigned 64-bit integer as a canonical decimal string.",
      "type": "string",
      "pattern": "^(0|[1-9][0-9]{0,19})$"
    },
    "Scope": {
      "description": "What a credential may do at most.",
      "type": "object",
      "properties": {
        "actions": {
          "description": "Actions.",
          "$ref": "#/$defs/ScopeSetOfActionName"
        },
        "expires_at": {
          "description": "From this instant on the credential no longer verifies. `None` only for a master.",
          "anyOf": [
            {
              "$ref": "#/$defs/WallTime"
            },
            {
              "type": "null"
            }
          ]
        },
        "pockets": {
          "description": "Pockets the credential may act in.",
          "$ref": "#/$defs/ScopeSetOfPocketId"
        },
        "pools": {
          "description": "Budget pools it may reserve from.",
          "$ref": "#/$defs/ScopeSetOfPoolId"
        },
        "resources": {
          "description": "Resources.",
          "$ref": "#/$defs/ScopeSetOfResourcePattern"
        }
      },
      "additionalProperties": false,
      "required": [
        "actions",
        "resources",
        "pockets",
        "pools"
      ]
    },
    "ScopeSetOfActionName": {
      "description": "One dimension of a scope: everything, or only the listed members.",
      "oneOf": [
        {
          "description": "No restriction in this dimension.",
          "type": "string",
          "const": "any"
        },
        {
          "description": "Only these members (at most [`limits::MAX_SCOPE_ITEMS`]).",
          "type": "object",
          "properties": {
            "only": {
              "type": "array",
              "items": {
                "$ref": "#/$defs/ActionName"
              },
              "maxItems": 8,
              "uniqueItems": true
            }
          },
          "additionalProperties": false,
          "required": [
            "only"
          ]
        }
      ]
    },
    "ScopeSetOfPocketId": {
      "description": "One dimension of a scope: everything, or only the listed members.",
      "oneOf": [
        {
          "description": "No restriction in this dimension.",
          "type": "string",
          "const": "any"
        },
        {
          "description": "Only these members (at most [`limits::MAX_SCOPE_ITEMS`]).",
          "type": "object",
          "properties": {
            "only": {
              "type": "array",
              "items": {
                "$ref": "#/$defs/PocketId"
              },
              "maxItems": 8,
              "uniqueItems": true
            }
          },
          "additionalProperties": false,
          "required": [
            "only"
          ]
        }
      ]
    },
    "ScopeSetOfPoolId": {
      "description": "One dimension of a scope: everything, or only the listed members.",
      "oneOf": [
        {
          "description": "No restriction in this dimension.",
          "type": "string",
          "const": "any"
        },
        {
          "description": "Only these members (at most [`limits::MAX_SCOPE_ITEMS`]).",
          "type": "object",
          "properties": {
            "only": {
              "type": "array",
              "items": {
                "$ref": "#/$defs/PoolId"
              },
              "maxItems": 8,
              "uniqueItems": true
            }
          },
          "additionalProperties": false,
          "required": [
            "only"
          ]
        }
      ]
    },
    "ScopeSetOfResourcePattern": {
      "description": "One dimension of a scope: everything, or only the listed members.",
      "oneOf": [
        {
          "description": "No restriction in this dimension.",
          "type": "string",
          "const": "any"
        },
        {
          "description": "Only these members (at most [`limits::MAX_SCOPE_ITEMS`]).",
          "type": "object",
          "properties": {
            "only": {
              "type": "array",
              "items": {
                "$ref": "#/$defs/ResourcePattern"
              },
              "maxItems": 8,
              "uniqueItems": true
            }
          },
          "additionalProperties": false,
          "required": [
            "only"
          ]
        }
      ]
    },
    "WallTime": {
      "description": "RFC 3339 instant in UTC with a Z suffix.",
      "type": "string",
      "format": "date-time",
      "pattern": "Z$"
    }
  }
}
